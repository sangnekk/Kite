# Admin console
# The owner of the instance is set with `system_owner = "<your Discord user ID>"` at the top of
# kite.toml (or KITE_SYSTEM_OWNER here). Everything else is managed in the console at /admin/.
#KITE_SYSTEM_OWNER=



# Billing
# Discord webhook URL that receives SePay transaction error alerts.
# Optional — leave empty to disable error notifications.
DISCORD_ERROR_WEBHOOK_URL=

# Frontend
# Build/deploy label shown under the app name in the sidebar (baked into the web
# build). Set to anything, e.g. "Stable build". Defaults to "Stable build" for
# Docker builds; if the var is absent entirely (e.g. local `npm run dev`) the UI
# shows "Developer build".
NEXT_PUBLIC_BUILD_LABEL=Stable build


# Docs
# Public URL of the web app. Baked into the docs build: the embedded node previews and
# the schema explorer load from here, so it must be reachable from the browser.
KITE_APP__PUBLIC_BASE_URL=https://bot.vibehost.vn
